{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.envrc", "effect": "deny" },
    { "action": "read", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "*/.config/gh/*", "effect": "deny" },
    { "action": "read", "resource": "*/.netrc", "effect": "deny" },
    { "action": "read", "resource": "*/.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "*_runner_file_commands*", "effect": "deny" },
    { "action": "read", "resource": "*/work/_temp/*", "effect": "deny" },
    { "action": "read", "resource": "/proc/*", "effect": "deny" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git * push*", "effect": "deny" },
    { "action": "shell", "resource": "git commit", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git * commit", "effect": "deny" },
    { "action": "shell", "resource": "git * commit *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase*", "effect": "deny" },
    { "action": "shell", "resource": "git * rebase*", "effect": "deny" },
    { "action": "shell", "resource": "git merge", "effect": "deny" },
    { "action": "shell", "resource": "git merge *", "effect": "deny" },
    { "action": "shell", "resource": "git * merge", "effect": "deny" },
    { "action": "shell", "resource": "git * merge *", "effect": "deny" },
    { "action": "shell", "resource": "git tag -a*", "effect": "deny" },
    { "action": "shell", "resource": "git tag -s*", "effect": "deny" },
    { "action": "shell", "resource": "git tag -d*", "effect": "deny" },
    { "action": "shell", "resource": "git tag -f*", "effect": "deny" },
    { "action": "shell", "resource": "git tag --annotate*", "effect": "deny" },
    { "action": "shell", "resource": "git tag --sign*", "effect": "deny" },
    { "action": "shell", "resource": "git tag --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git tag --force*", "effect": "deny" },
    { "action": "shell", "resource": "git reset*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr review*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr edit*", "effect": "deny" },
    { "action": "shell", "resource": "gh api *APPROVE*", "effect": "deny" },
    { "action": "shell", "resource": "gh api *approve*", "effect": "deny" },
    { "action": "shell", "resource": "gh api *merge*", "effect": "deny" },
    { "action": "shell", "resource": "npm install*", "effect": "deny" },
    { "action": "shell", "resource": "npm * install*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm*", "effect": "deny" },
    { "action": "shell", "resource": "yarn*", "effect": "deny" },
    { "action": "shell", "resource": "curl*", "effect": "deny" },
    { "action": "shell", "resource": "wget*", "effect": "deny" },
    { "action": "shell", "resource": "nc*", "effect": "deny" },
    { "action": "shell", "resource": "ncat*", "effect": "deny" },
    { "action": "shell", "resource": "socat*", "effect": "deny" },
    { "action": "shell", "resource": "ssh*", "effect": "deny" },
    { "action": "shell", "resource": "scp*", "effect": "deny" },
    { "action": "shell", "resource": "rsync*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "gh auth*", "effect": "deny" },
    { "action": "shell", "resource": "docker*", "effect": "deny" },
    { "action": "shell", "resource": "sudo*", "effect": "deny" },
    { "action": "shell", "resource": "bash -c*", "effect": "deny" },
    { "action": "shell", "resource": "sh -c*", "effect": "deny" },
    { "action": "shell", "resource": "eval*", "effect": "deny" },
    { "action": "shell", "resource": "source*", "effect": "deny" },
    { "action": "shell", "resource": "python* -c*", "effect": "deny" }
  ]
}
